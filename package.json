{
  "name": "@red-cup-engineering/web-release-candidate-service",
  "version": "0.3.2",
  "description": "Deterministic web artifact release manifests, verification, and profile parity.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/web-release-candidate-service.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/web-release-candidate.mjs"
    },
    "./observe-public-release": {
      "import": "./src/observe-public-release.mjs"
    }
  },
  "bin": {
    "verify-web-release-directory": "./scripts/verify-web-release-directory.mjs",
    "observe-public-release": "./scripts/observe-public-release.mjs"
  },
  "files": [
    "src",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "check": "node --check src/web-release-candidate.mjs && node --check src/verify-web-release-directory.mjs && node --check src/observe-public-release.mjs && node --check scripts/verify-web-release-directory.mjs && node --check scripts/observe-public-release.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "dependencies": {
    "@red-cup-engineering/json-engineering-services-section": "0.4.0",
    "@red-cup-engineering/uri-engineering-services-section": "0.1.1",
    "@red-cup-engineering/javascript-node-engineering-services-section": "0.3.2"
  },
  "private": false,
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  }
}
